# 이 파일을 .env 로 복사하고 값을 채우세요.

# 설명 화면 기획(Claude). 없으면 설명 화면 단계를 건너뜁니다.
ANTHROPIC_API_KEY=

# 일러스트 생성(OpenAI gpt-image-1). 없으면 플레이스홀더 도형 카드로 대체됩니다.
OPENAI_API_KEY=

# —— 선택 설정 (기본값 표시) ——————————————————————
# WHISPER_MODEL=large-v3          # GPU 없으면 비워 두세요(자동으로 small 사용)
# WHISPER_DEVICE=auto             # auto / cuda / cpu
# LANGUAGE=ko

# SILENCE_DB=-35                  # 무음 판정 기준(dB)
# MIN_SILENCE=0.6                 # 이 길이(초) 이상 무음만 편집
# KEEP_SILENCE=0.3                # 긴 무음을 이 길이로 줄임
# REMOVE_STUTTERS=true

# TONE=false                      # 말투 다듬기(자막 문장만 수정, Claude 사용)
# TONE_STYLE=친근하고 또렷한 존댓말, 군더더기 없이 간결하게
# SUBTITLES=false                 # 자막 입히기
# SUBTITLE_POSITION=bottom        # bottom | center | top
# SUBTITLE_CHARS=16               # 자막 한 줄 글자 수 (최대 2줄)
# SUBTITLE_FONT=Malgun Gothic     # 리눅스는 Noto Sans CJK KR 등으로 변경

# ILLUSTRATIONS=true
# ILLUSTRATION_MODE=center        # center(중앙 카드) | cutaway(전체 화면 전환) | pip(우측 카드)
# MAX_SCENES_PER_MIN=1.5
# CLAUDE_MODEL=claude-opus-5-5
# IMAGE_PROVIDER=auto             # auto | openai | placeholder
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium            # low | medium | high
# IMAGE_CONCURRENCY=4             # 이미지 동시 생성 개수 (API 한도에 걸리면 낮추세요)
# LOGO_DIR=./로고

# MOSAIC=true
# OCR_INTERVAL=0.5                # 초 단위 화면 검사 간격 (짧을수록 정확, 느림)
# BLUR_FACES=false                # 얼굴 모자이크는 본인 얼굴도 가려지므로 기본 OFF
# MUTE_SPOKEN_PII=false           # 말로 나온 개인정보 음소거

# VIDEO_CODEC=auto                # auto | h264_nvenc | libx264
# VIDEO_QUALITY=19                # 낮을수록 고화질(파일 커짐)
# OUT_DIR=./output
# WORK_DIR=./work
